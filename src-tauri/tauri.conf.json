{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wirebench",
  "version": "0.11.0",
  "identifier": "app.wirebench.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wirebench",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' data: blob:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Breadboard designer and Arduino simulator",
    "publisher": "Sudchai Boonto",
    "copyright": "Copyright (c) 2026 Sudchai Boonto. MIT License.",
    "license": "MIT",
    "fileAssociations": [
      {
        "ext": ["wbproj"],
        "name": "Wirebench project",
        "description": "Wirebench project",
        "mimeType": "application/x-wirebench-project",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi"
      }
    },
    "category": "Education"
  }
}
